# --- Secrets / credentials — never commit these
.env
*.env
.onc_token
*token*.txt
*_secret*

# --- Large regenerables (rebuild via scripts/, don't commit)
data/era5/
data/*_cache/
data/raw/
data/derived/model_predictions.csv
*.parquet
/model_grid/

